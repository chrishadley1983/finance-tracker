  "__knownLimitations": [
   {
    "id": "tfc-nominal-cap",
    "raised": "2026-09-20",
    "fixBy": "2027-06-01",
    "text": "Tax-free cash is modelled as a cumulative real allowance of £268,275 each, with no 25%-of-crystallised-pot limit. The lump sum allowance is frozen in cash (≈£195k real by 2041) and 25% of each pot is ≈£200k, so the model over-counts tax-free money by about £145k real. Lifetime drawdown tax is about £44k at 2% real and £115k at 0%, not ≈£0.",
    "impact": "tax narrative only; survival unaffected"
   },
   {
    "id": "thresholds-held-real",
    "raised": "2026-09-20",
    "text": "Personal allowance, basic-rate band and state pension are held constant in real terms for the whole simulation. The allowance is frozen in cash to April 2031 (≈£11.5k real by then); the state pension is uprated by the triple lock. Small, opposite-signed biases.",
    "impact": "≈£0.5k/yr of tax from 2041"
   },
   {
    "id": "iht-not-modelled",
    "raised": "2026-09-20",
    "text": "Pensions join the estate for inheritance tax from April 2027. The planning case leaves roughly £1.8M in pensions at 2075, implying IHT of the order of £850k plus beneficiary income tax. Drawing to the basic-rate band from 2041 should become the planning case; it is not yet.",
    "impact": "dominant tax in every path; not a spending risk"
   },
   {
    "id": "nic-cap-2029",
    "raised": "2026-09-20",
    "fixBy": "2029-04-06",
    "text": "From April 2029 salary-sacrificed pension contributions above £2,000/yr attract employee and employer NIC, so relief on the excess falls from 42% to 40% (about £3.7k over the remaining programme) and Accenture may restructure the AVC facility. The pivot model uses 42% throughout.",
    "impact": "≈£3.7k take-home; scheme-availability risk unquantified"
   },
   {
    "id": "fees-and-crypto",
    "raised": "2026-09-20",
    "text": "Platform and dealing fees (~£8k to 2045) are unmodelled; crypto (~£54k) is treated as equity at 2% real and never drawn; the sustainable-spend column in the ledger document is the 3 Sep outlook figure and £70k/yr does not survive the flat-0% case under the ledger's tax rules.",
    "impact": "small"
   }
  ]
 },
